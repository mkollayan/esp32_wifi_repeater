# ESP32-S3-DevKitC-1 N16R8（本仓库主目标板）
# 模组：ESP32-S3-WROOM-1-N16R8 — 16 MB flash、8 MB Octal PSRAM；板载 WS2812 数据脚 GPIO48
# Flash 用 DIO（所有 flash 都支持）。模组支持 QIO 时可改为 CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 控制台：板载「UART」口走 USB-UART（默认 UART0）；「USB」口为片内 USB Serial/JTAG（可选改 CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Wi-Fi/lwIP 缓冲优先放 PSRAM，省内部 RAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 加大 Wi-Fi 收发缓冲与接收聚合窗口（默认：静态 RX 16、动态 RX 32、静态 TX 16、缓存 TX 32、BA 窗口 16），
# 转发流量大时少丢包、少重传；静态 RX / TX 缓冲在内部 RAM，合计多占约 40 KB
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
# DevKitC-1 板载 WS2812（与 Kconfig 默认一致，显式写出）
CONFIG_REPEATER_LED_GPIO=48
